{
  "name": "obvious-ridge-route",
  "version": "2.0.0",
  "private": true,
  "description": "Obvious Ridge Route studio website, built with Jekyll and Tailwind CSS and published by GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build:css": "postcss src/styles/main.css --output assets/css/site.css --no-map",
    "watch:css": "postcss src/styles/main.css --output assets/css/site.css --no-map --watch",
    "build": "npm run build:css && bundle exec jekyll build",
    "serve": "bundle exec jekyll serve --livereload",
    "dev": "run-p watch:css serve",
    "docker:build": "sh scripts/jekyll-docker.sh build",
    "docker:serve": "sh scripts/jekyll-docker.sh serve",
    "test": "npm run test:unit && npm run test:site",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:site": "node --test tests/site/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obvious-Ridge-Route/Obvious-Ridge-Route.github.io.git"
  },
  "homepage": "https://obviousridgeroute.com",
  "license": "UNLICENSED",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "cssnano": "^7.1.9",
    "linkedom": "^0.18.14",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.31",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.1"
  }
}
